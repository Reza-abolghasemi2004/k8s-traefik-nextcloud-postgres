apiVersion: traefik.io/v1alpha1
kind: IngressRoute

metadata:
  name: nextcloud
  namespace: nextcloud

spec:
  entryPoints:
    - websecure

  routes:
    - match: Host(`your Domain.com or subdomain`)
      kind: Rule

      services:
        - name: nextcloud
          port: 80
  tls:
    secretName: cloud-tls
